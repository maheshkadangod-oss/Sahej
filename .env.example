# Sahej environment variables
#
# The app runs fine with NONE of these set — they enable optional server features.
# Set them in the Vercel dashboard (Project → Settings → Environment Variables).

# --- Web Push (Phase 2 vaccination/weight reminders that fire when the app is closed) ---
# Generate a pair with:  npx web-push generate-vapid-keys
# The PUBLIC key is exposed to the browser (VITE_ prefix); keep PRIVATE secret.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI for push services (mailto: or https:)
VAPID_SUBJECT=mailto:hello@sahej.app
# Shared secret that protects the cron send endpoint. Set the same value as the
# Vercel Cron "Authorization" if you customize it; otherwise Vercel injects it.
CRON_SECRET=

# --- Upstash Redis (registrations, feedback, share links, push subscriptions) ---
# Provided automatically when you connect Upstash via the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Misc ---
# Comma-separated allowed origins for CORS (optional; defaults to *).
ALLOWED_ORIGINS=
